{
  "patchproof-quality-gate": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check src/ tests/",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys; sys.exit(0)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
